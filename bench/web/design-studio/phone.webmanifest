{
  "name": "VisualizeIT",
  "short_name": "VisualizeIT",
  "description": "Experimental camera preview for mapping designs onto objects. Tracking is not validated.",
  "id": "/camera",
  "start_url": "/camera",
  "scope": "/",
  "display": "standalone",
